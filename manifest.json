{
  "manifest_version": 3,
  "name": "SangTacViet Drive Sync",
  "version": "0.1.0",
  "description": "Sync SangTacViet reading history and names across browsers through your Google Drive.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "identity", "alarms", "scripting"],
  "host_permissions": [
    "*://*.sangtacviet.com/*",
    "*://*.sangtacviet.app/*",
    "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SangTacViet Drive Sync",
    "default_popup": "dist/popup.html",
    "default_icon": { "16": "dist/icons/16.png", "32": "dist/icons/32.png", "48": "dist/icons/48.png", "128": "dist/icons/128.png" }
  },
  "icons": { "16": "dist/icons/16.png", "32": "dist/icons/32.png", "48": "dist/icons/48.png", "128": "dist/icons/128.png" },
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": true
  }
}
